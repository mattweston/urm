{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "es5",
  "tabWidth": 4,
  "useTabs": false,
  "semi": false,
  "singleQuote": false,
  "printWidth": 80,
  "endOfLine": "lf",
  "ternaries": true,
  "experimental_sort_imports": {
    "order": "asc"
  },
  "ignorePatterns": [
    "**/.todo/**",
    "**/.context/**"
  ]
}
