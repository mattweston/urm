{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "resolve": {
      "outputs": ["styles/**"]
    },
    "test": {
      "dependsOn": ["^resolve"]
    },
    "typecheck": {
      "dependsOn": ["^resolve"]
    },
    "validate": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
