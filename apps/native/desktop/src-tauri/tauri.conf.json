{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "URM",
    "version": "0.0.1",
    "identifier": "dev.urm.desktop",
    "build": {
        "beforeDevCommand": "pnpm --filter @urm/client dev",
        "devUrl": "http://127.0.0.1:1420",
        "frontendDist": "../../client/dist",
        "beforeBuildCommand": "pnpm --filter @urm/client build"
    },
    "app": {
        "windows": [
            {
                "title": "URM",
                "width": 1100,
                "height": 750,
                "minWidth": 480,
                "minHeight": 360
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
