{
    "extends": "@urm/config/tsconfig.base.json",
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "composite": false,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ES2023",
            "DOM",
            "DOM.Iterable"
        ],
        "types": [
            "node",
            "vite/client",
            "vitest/globals"
        ]
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
