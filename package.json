{
    "name": "urm",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "grant-sysadmin": "pnpm --filter server auth:grant-sysadmin --email=matthiasweston@fastmail.com --name='Matthias Weston' --scope=platform --confirm=grant:matthiasweston@fastmail.com:platform",
        "audit:npm": "cve-lite /home/matt/urm --verbose",
        "audit:pnpm": "pnpm audit",
        "dev:client": "pnpm --filter @urm/client dev | tee logs/client.log",
        "dev:desktop": "pnpm --filter @urm/desktop dev",
        "dev:server": "tsx apps/server/src/main.ts | tee logs/server.log",
        "dev:server:kill": "node scripts/stop-dev-server.mjs",
        "dev": "pnpm dev:client",
        "build:client": "pnpm --filter @urm/client build",
        "build:desktop": "pnpm --filter @urm/desktop build",
        "preview:client": "pnpm --filter @urm/client preview",
        "mobile:doctor": "pnpm --filter @urm/mobile doctor",
        "mobile:add:android": "pnpm --filter @urm/mobile add:android",
        "mobile:devices:android": "pnpm --filter @urm/mobile devices:android",
        "mobile:run:android": "pnpm --filter @urm/mobile run:android",
        "mobile:sync:android": "pnpm --filter @urm/mobile sync:android",
        "mobile:open:android": "pnpm --filter @urm/mobile open:android",
        "mobile:add:ios": "pnpm --filter @urm/mobile add:ios",
        "mobile:devices:ios": "pnpm --filter @urm/mobile devices:ios",
        "mobile:run:ios": "pnpm --filter @urm/mobile run:ios",
        "mobile:sync:ios": "pnpm --filter @urm/mobile sync:ios",
        "mobile:open:ios": "pnpm --filter @urm/mobile open:ios",
        "mobile:sync": "pnpm --filter @urm/mobile sync",
        "docs:lint": "tsx packages/tools/linter/src/docs-headings.ts && pnpm docgen:llm:check && tsx packages/tools/linter/src/docs-budget.ts",
        "docs:lint:fix": "pnpm docs:lint --fix",
        "docgen:llm": "tsx packages/tools/llm-docgen/src/main.ts llm-docs/src -o LLMS.md",
        "docgen:llm:watch": "pnpm docgen:llm --watch",
        "docgen:llm:check": "pnpm docgen:llm --check",
        "lint": "oxlint .",
        "test": "pnpm -r test",
        "typecheck": "pnpm -r typecheck",
        "prepare": "effect-tsgo patch",
        "diagnostics": "effect-tsgo diagnostics --project tsconfig.json",
        "check": "pnpm typecheck && pnpm lint && pnpm test",
        "typecheck:core": "pnpm --filter @urm/contracts --filter @urm/database --filter @urm/domain --filter @urm/env --filter @urm/utils typecheck"
    },
    "devDependencies": {
        "@effect/tsgo": "catalog:server",
        "@effect/vitest": "catalog:testing",
        "@happy-dom/global-registrator": "20.0.0",
        "@prettier/plugin-oxc": "0.0.4",
        "@types/node": "catalog:server",
        "@urm/config": "workspace:*",
        "@urm/domain": "workspace:*",
        "@urm/email": "workspace:*",
        "@urm/features": "workspace:*",
        "@urm/ui": "workspace:*",
        "@urm/utils": "workspace:*",
        "agent-tail": "catalog:llms",
        "concurrently": "catalog:dev",
        "dotenv": "catalog:dev",
        "effect": "catalog:",
        "opencode-ai": "catalog:llms",
        "oxfmt": "catalog:lint",
        "oxlint": "catalog:lint",
        "prettier": "catalog:lint",
        "ts-morph": "27.0.0",
        "tsx": "4.19.3",
        "turbo": "catalog:build",
        "typescript": "catalog:",
        "vitest": "catalog:testing"
    }
}
