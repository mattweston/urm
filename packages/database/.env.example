# Database Environment Configuration
# Copy this file to .env and fill in your actual values
#
#
# TODO:
# DATABASE_URL_ROLE_SYSADMIN=""
# DATABASE_URL_ROLE_ADMIN=""
# DATABASE_URL_ROLE_MEMBER=""
# DATABASE_URL_ROLE_VISITOR=""

# ============================================
# Development Database
# Used when NODE_ENV=development
# ============================================
DATABASE_URL_DEV=postgresql://user:password@localhost:5432/urm_dev

# ============================================
# Staging Database
# Used when NODE_ENV=staging
# ============================================
DATABASE_URL_STAGE=postgresql://user:password@localhost:5432/urm_stage

# ============================================
# Production Database
# Used when NODE_ENV=production
# ============================================
DATABASE_URL_PROD=postgresql://user:password@localhost:5432/urm_prod

# ============================================
# Demo Database
# Separate database for marketing site demos
# Used when IS_DEMO=true
# ============================================
DATABASE_URL_DEMO=postgresql://user:password@localhost:5432/urm_demo

# ============================================
# Demo Mode
# Set to 'true' to enable demo mode (uses DATABASE_URL_DEMO)
# ============================================
IS_DEMO=false

# ============================================
# Node Environment
# Determines which database configuration to use
# Options: development | staging | production
# ============================================
NODE_ENV=development

# ============================================
# Example: PlanetScale URLs
# Uncomment and modify if using PlanetScale
# ============================================
# The `urm` database is PlanetScale Postgres, not MySQL, so these are
# postgresql:// URLs. Get one per branch with:
#   pscale password create urm <branch> <password-name> --org urm
# A branch is the unit of isolation here, so point each environment at its own.
# DATABASE_URL_DEV=postgresql://user:pass@HOST.psdb.cloud/urm?sslmode=verify-full
# DATABASE_URL_STAGE=postgresql://user:pass@HOST.psdb.cloud/urm?sslmode=verify-full
# DATABASE_URL_PROD=postgresql://user:pass@HOST.psdb.cloud/urm?sslmode=verify-full
# DATABASE_URL_DEMO=postgresql://user:pass@HOST.psdb.cloud/urm?sslmode=verify-full

# ============================================
# Notes:
# - Each environment uses its own DATABASE_URL_* variable
# - Demo database must be different from production (safety check)
# - Development uses 'drizzle-kit push' instead of migrations
# - Staging/Production use traditional migrations
# ============================================
