{
    "name": "@urm/ssg",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./*": "./src/*.ts",
        "./*/index": null,
        "./internal/*": null,
        "./package.json": "./package.json"
    },
    "scripts": {
        "build:fixture": "tsx scripts/build-fixture.ts",
        "build:deployment": "tsx scripts/build-deployment.ts",
        "deploy:site": "alchemy deploy alchemy.run.ts",
        "test": "vitest run",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@effect/platform-node": "catalog:server",
        "@foldkit/markdown": "0.9.2",
        "@urm/domain": "workspace:*",
        "@urm/ui": "workspace:*",
        "effect": "catalog:",
        "foldkit": "catalog:",
        "mapbox-gl": "catalog:ui",
        "vite": "8.0.13"
    },
    "devDependencies": {
        "alchemy": "2.0.0-beta.67",
        "vitest": "catalog:testing"
    }
}
