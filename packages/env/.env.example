
# Central env template for server-side config.
# Copy to packages/config/env/.env (or use as root .env with bun --env-file).
# Client-side: Astro uses PUBLIC_*; Vite uses VITE_* or PUBLIC_* (see apps/marketing).

# -----------------------------------------------------------------------------
# Alchemy / Cloudflare Deployment
# -----------------------------------------------------------------------------
# Required for deploying to Cloudflare via Alchemy
# Get API token: https://dash.cloudflare.com/profile/api-tokens
# Token needs: Cloudflare Workers (Edit), Pages (Edit), KV (Edit), R2 (Edit)
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
# Required if using alchemy.secret() for encrypted values
# Set a strong password to encrypt/decrypt secrets in state files
ALCHEMY_PASSWORD=""
# Optional: override default stage (defaults to $USER)
# ALCHEMY_STAGE=dev

DEV_DB_URL=""
TEST_DB_URL=""
STAGING_DB_URL=""
PROD_DB_URL=""

# -----------------------------------------------------------------------------
# Server / URLs
# -----------------------------------------------------------------------------
API_URL="http://localhost:1234"
APP_URL="http://localhost:4321"
# ADMIN_APP_URL="http://localhost:4321" NO
MARKETING_APP_URL="http://localhost:4321"
# Tailnet-accessible local development:
# ADMIN_APP_URL="http://urmdev.test:5173"
# MARKETING_APP_URL="http://urmdev.test:4321"
PORT=1234
# COOKIE_DOMAIN=           # optional; default .urm.dev in production

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
AUTH_SECRET="secretkey"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# ADMIN_EMAILS=             # optional comma-separated for admin role
# ADMIN_USER_IDS=           # optional comma-separated

# -----------------------------------------------------------------------------
# Cart / session (client or server)
# -----------------------------------------------------------------------------
CART_SESSION_SECRET=""

# -----------------------------------------------------------------------------
# Database / Zero
# -----------------------------------------------------------------------------
ZERO_UPSTREAM_DB=""
# DATABASE_URL=             # alternative to ZERO_UPSTREAM_DB for drizzle
# Replica path: use zero.db when running from packages/sync (e.g. dev:sync)
ZERO_REPLICA_FILE="zero.db"
ZERO_APP_PUBLICATIONS=zero_data
ZERO_UPSTREAM_MAX_CONNS=5
ZERO_CVR_MAX_CONNS=10
ZERO_CHANGE_MAX_CONNS=2
ZERO_NUM_SYNC_WORKERS=2
ZERO_MUTATE_FORWARD_COOKIES="true"
ZERO_QUERY_FORWARD_COOKIES="true"
ZERO_MUTATE_URL="http://localhost:1234/mutate"
ZERO_QUERY_URL="http://localhost:1234/query"

# -----------------------------------------------------------------------------
# Storage (S3-compatible, e.g. Tigris)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3="https://fly.storage.tigris.dev"
AWS_ENDPOINT_URL_IAM="https://fly.iam.storage.tigris.dev"
AWS_REGION=auto
BUCKET_NAME=""

# -----------------------------------------------------------------------------
# Shop (Stripe)
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Mail (Resend)
# -----------------------------------------------------------------------------
# RESEND_WEBHOOK_SECRET=
# API_BASE_URL="http://localhost:4321"

# -----------------------------------------------------------------------------
# Mail (Cloudflare Email Sending)
# -----------------------------------------------------------------------------
# Read through CloudflareEmailConfig; CLOUDFLARE_ACCOUNT_ID is set above.
# CLOUDFLARE_EMAIL_ENABLED=false
# CLOUDFLARE_EMAIL_API_TOKEN=
# CLOUDFLARE_EMAIL_FROM="notifications@mail.urm.dev"
# CLOUDFLARE_EMAIL_TRANSPORT=rest        # rest | smtp
# Inbound delivery events (optional).
# CLOUDFLARE_EMAIL_EVENTS_ENABLED=false
# CLOUDFLARE_EMAIL_EVENTS_API_TOKEN=
# CLOUDFLARE_EMAIL_EVENTS_QUEUE_ID=
# CLOUDFLARE_EMAIL_EVENTS_SUBSCRIPTION_IDS=

# -----------------------------------------------------------------------------
# Social (Zernio)
# -----------------------------------------------------------------------------
# The server verifies X-Zernio-Signature on /webhooks/zernio with this secret.
# Generate it with: openssl rand -hex 32
# ZERNIO_WEBHOOK_SECRET=
# ZERNIO_API_KEY=
# Default profile ID; remove once Social uses one profile per URM domain.
# ZERNIO_PROFILE_ID=

# -----------------------------------------------------------------------------
# Client / build (TanStack Start: VITE_*; Astro: PUBLIC_*; often in app .env)
# -----------------------------------------------------------------------------
# Zero - used by TanStack Start / Vite client
VITE_ZERO_CACHE_URL="http://localhost:4848"
VITE_ZERO_QUERY_URL="http://localhost:1234/query"
VITE_ZERO_MUTATE_URL="http://localhost:1234/mutate"
# Auth endpoint used by the Vite browser client.
VITE_AUTH_ISSUER="http://localhost:1234/auth"
# Auth endpoint used by the Astro browser client.
PUBLIC_AUTH_ISSUER="http://localhost:1234/auth"
# Remote development must use a stable HTTPS API origin for Google OAuth.
# VITE_PUBLIC_ZERO_CACHE_URL=  # alias if needed
# PUBLIC_APP_URL=

# -----------------------------------------------------------------------------
# Tooling / optional
# -----------------------------------------------------------------------------
# NODE_ENV=development
# DEBUG=
# DOCS_OUTPUT_DIR=apps/docs/src/content/docs/docs
# VITE_SERVER_PORT=4321
