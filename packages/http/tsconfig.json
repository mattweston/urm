{
    "extends": "../../packages/tools/config/tsconfig.base.json",
    "include": ["src/**/*.ts"],
    "exclude": [
        "node_modules",
        "dist",
        "**/.todo/**",
        "**/_TODO/**",
        ".examples",
        ".context",
        ".btca",
        ".opencode",
        ".bkups"
    ],
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022"],
        "types": ["node"],
        "noEmit": true
    }
}
