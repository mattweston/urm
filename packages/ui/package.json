{
    "name": "@urm/ui",
    "version": "0.0.0",
    "private": true,
    "homepage": "https://github.com/mattweston/urm",
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./*": "./src/*",
        "./*/index": null,
        "./auth/*": "./src/auth/*",
        "./branding": "./src/branding/index.ts",
        "./branding/*": "./src/branding/*",
        "./branding/logos": "./src/branding/logos/index.ts",
        "./core/*": "./src/core/*",
        "./demos/*": "./src/demos/*",
        "./dialog/*": "./src/dialog/*",
        "./editor/*": "./src/editor/*",
        "./effectify/*": "./src/effectify/*",
        "./errors/*": "./src/errors/*",
        "./features/*": "./src/features/*",
        "./foldkit/logo": "./src/foldkit/logo.ts",
        "./forms/*": "./src/forms/*",
        "./hooks/*": "./src/hooks/*",
        "./internal/*": null,
        "./layout/*": "./src/layout/*",
        "./layout/astro*": "./src/layout/astro/*",
        "./media/*": "./src/media/*",
        "./nav/*": "./src/nav/*",
        "./package.json": "./package.json",
        "./search/*": "./src/search/*",
        "./skeletons/*": "./src/skeletons/*",
        "./solid/*": "./src/solid/*",
        "./stats/*": "./src/stats/*",
        "./styles/*": "./src/styles/*",
        "./ui/*": "./src/ui/*",
        "./urmcss/styles.css": "./src/urmcss/src/index.css"
    },
    "scripts": {
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@foldkit/ui": "catalog:ui",
        "@sentry/browser": "catalog:observability",
        "@shikijs/core": "4.2.0",
        "@shikijs/engine-javascript": "4.2.0",
        "@shikijs/langs": "4.2.0",
        "@shikijs/magic-move": "^4.4.2",
        "@tiptap/core": "catalog:ui",
        "@tiptap/extension-link": "catalog:ui",
        "@tiptap/starter-kit": "catalog:ui",
        "@urm/domain": "workspace:*",
        "@urm/utils": "workspace:*",
        "chart.js": "catalog:ui",
        "class-variance-authority": "catalog:layout",
        "clsx": "catalog:layout",
        "date-fns": "catalog:utils",
        "effect": "catalog:",
        "foldkit": "catalog:",
        "mapbox-gl": "catalog:ui",
        "photoswipe": "catalog:ui",
        "prosekit": "catalog:ui",
        "shiki": "4.2.0",
        "tailwind-merge": "catalog:layout",
        "tailwindcss": "catalog:layout",
        "three": "catalog:ui",
        "tw-animate-css": "catalog:layout"
    },
    "devDependencies": {
        "@urm/config": "workspace:*",
        "typescript": "catalog:",
        "vite": "catalog:build"
    }
}
